# MySQL 连接配置。复制为 .env 后填写真实账号；不要提交 .env。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=crawler_app
DB_PASSWORD=
DB_NAME=Data_Scraping
DB_CONNECTION_LIMIT=6

# 公网或生产环境建议启用 TLS；启用时必须同时配置可信 CA 证书。
DB_SSL=false
# DB_SSL_CA_PATH=/absolute/path/to/mysql-ca.pem

# geno-digital-api RPA 连接。需要相关表 SELECT、结果表 INSERT，以及
# rpa_task_execution 指定字段 UPDATE；不要授予 dispatch 状态写权限。
RPA_DB_HOST=127.0.0.1
RPA_DB_PORT=3306
RPA_DB_USER=rpa_worker
RPA_DB_PASSWORD=
RPA_DB_NAME=
RPA_DB_CONNECTION_LIMIT=8
RPA_DB_MAX_IDLE=8
RPA_DB_IDLE_TIMEOUT_MS=60000
RPA_DB_QUEUE_LIMIT=50
RPA_DB_CONNECT_TIMEOUT_MS=10000
RPA_DB_ACQUIRE_TIMEOUT_MS=10000
RPA_DB_QUERY_TIMEOUT_MS=15000
RPA_DB_LOCK_QUERY_TIMEOUT_MS=5000
RPA_DB_SSL=false
# RPA_DB_SSL_CA_PATH=/absolute/path/to/mysql-ca.pem

# 最终 RPA Worker：首次部署默认 dry-run=true，确认后再按进程显式关闭。
RPA_DIAGNOSIS_WORKER_ID=diagnosis-worker
RPA_DIAGNOSIS_CDP_ENDPOINT=http://127.0.0.1:9222
RPA_DIAGNOSIS_CHROME_PROFILE=/absolute/path/to/chrome-profiles/diagnosis
RPA_DIAGNOSIS_LOG_DIR=/absolute/path/to/rpa-runtime/diagnosis/logs
RPA_DIAGNOSIS_EVIDENCE_DIR=/absolute/path/to/rpa-runtime/diagnosis/evidence
RPA_DIAGNOSIS_OUTBOX_DIR=/absolute/path/to/rpa-runtime/diagnosis/outbox
RPA_DIAGNOSIS_METRICS_DIR=/absolute/path/to/rpa-runtime/diagnosis/metrics
RPA_DIAGNOSIS_DRY_RUN=true
# 单次诊断通常为 8 道题 × 4 个平台；32 可让四个平台在同一轮并行执行。
# 平台之间并行；同一平台内部仍按品牌批次串行，一个批次只创建一个对话。
RPA_DIAGNOSIS_MAX_TASKS=32
RPA_DIAGNOSIS_PLATFORMS=doubao,deepseek,qianwen,yuanbao
# DIAGNOSIS 可选 REQUIRED、PREFERRED、DISABLED。
RPA_DIAGNOSIS_WEB_SEARCH_POLICY=PREFERRED

RPA_MONITOR_WORKER_ID=monitor-worker
RPA_MONITOR_CDP_ENDPOINT=http://127.0.0.1:9223
RPA_MONITOR_CHROME_PROFILE=/absolute/path/to/chrome-profiles/monitor
RPA_MONITOR_LOG_DIR=/absolute/path/to/rpa-runtime/monitor/logs
RPA_MONITOR_EVIDENCE_DIR=/absolute/path/to/rpa-runtime/monitor/evidence
RPA_MONITOR_OUTBOX_DIR=/absolute/path/to/rpa-runtime/monitor/outbox
RPA_MONITOR_METRICS_DIR=/absolute/path/to/rpa-runtime/monitor/metrics
RPA_MONITOR_DRY_RUN=true
# 文章监测单轮可能有最多 100 个样本；使用允许上限，尽量让四个平台同轮执行。
# 平台之间并行；同一平台内部并发仍固定为 1。
RPA_MONITOR_MAX_TASKS=100
RPA_MONITOR_PLATFORMS=doubao,deepseek,qianwen,yuanbao
# ARTICLE_PROBE 在代码中强制 REQUIRED，此处用于明确部署意图。
RPA_MONITOR_WEB_SEARCH_POLICY=REQUIRED

# 最新词条监测：默认关闭，只过滤 monitor 内的 ENTRY_MONITOR，不影响 DIAGNOSIS。
# 启用前 Java 必须提供 rpa_task_execution_context 不可变上下文，并同时开启
# RPA_WORKER_PROVIDER_ROUTING_ENABLED、配置至少一个灰度 project ID。
ENTRY_MONITOR_ENABLED=false
ENTRY_MONITOR_GRAY_PROJECT_IDS=
ENTRY_MONITOR_PROJECT_CHUNK_SIZE=5
ENTRY_MONITOR_CONVERSATION_MAX_QUESTIONS=10000
ENTRY_MONITOR_CONVERSATION_MAX_DURATION_MS=86400000
ENTRY_MONITOR_TIMEZONE=Asia/Shanghai
# 内容风格监测使用独立门禁；Java 尚未写齐通用 execution context 前必须保持 false。
CONTENT_STYLE_MONITOR_ENABLED=false
CONTENT_STYLE_MONITOR_GRAY_PROJECT_IDS=
# 历史 ARTICLE_PROBE 存量领取开关；存量清零前保持 true。
ARTICLE_PROBE_LEGACY_ENABLED=true
# ENTRY_MONITOR 会话统一写入 rpa_conversation_session，无本地 JSON 状态文件。

# 两个 Worker 可共享；stale 必须至少是 heartbeat 的 3 倍。
# 安全门禁：默认 staging；production 即使 dry-run=false 也必须额外显式授权。
RPA_WORKER_ENVIRONMENT=staging
RPA_WORKER_ALLOW_PRODUCTION_CLAIMS=false
# 只有执行 worker_provider migration 且旧 RPA 已隔离后才开启。
RPA_WORKER_PROVIDER_ROUTING_ENABLED=false
RPA_WORKER_PROVIDER=NEW_RPA
RPA_WORKER_GRAY_BRAND_IDS=
RPA_WORKER_GRAY_BUSINESS_TASK_IDS=
RPA_WORKER_GRAY_PERCENTAGE=100
# diagnosis 默认只允许最早的两个未完成品牌被领取：当前品牌 + 最多领先一个品牌。
# 品牌只有在四个平台的 execution 全部成功后才移出窗口；monitor 默认不启用该屏障。
RPA_DIAGNOSIS_BRAND_WINDOW_SIZE=2
RPA_DIAGNOSIS_BRAND_BARRIER_PLATFORMS=doubao,deepseek,qianwen,yuanbao
RPA_WORKER_HEARTBEAT_MS=30000
RPA_WORKER_STALE_AFTER_MS=300000
RPA_WORKER_WATCHDOG_STALL_MS=300000
RPA_WORKER_PLATFORM_RECHECK_INTERVAL_MS=60000
RPA_WORKER_PLATFORM_READY_CONFIRMATIONS=2
RPA_WORKER_PLATFORM_PROCESS_RESTART_MS=5000
RPA_WORKER_RECOVER_STALE=true
RPA_WORKER_RUN_ONCE=false
RPA_WORKER_POLL_INTERVAL_MS=10000
RPA_WORKER_POLL_JITTER_MS=1000
# 原子 JSON 指标快照刷新/数据库状态聚合的最小间隔。
RPA_WORKER_METRICS_INTERVAL_MS=15000
RPA_WORKER_MAX_ATTEMPTS=3
RPA_WORKER_RETRY_BACKOFF_MS=30000
RPA_WORKER_RETRY_JITTER_MS=5000
# 只有执行 next_retry_at migration 后才开启；默认兼容旧表。
RPA_WORKER_DATABASE_RETRY_SCHEDULE_ENABLED=false
RPA_WORKER_OUTBOX_WRITE_RETRY_MS=5000
RPA_WORKER_BROWSER_RECONNECT_ATTEMPTS=3
RPA_WORKER_BROWSER_RECONNECT_BACKOFF_MS=2000
RPA_WORKER_TASK_INTERVAL_MS=5000
RPA_WORKER_BATCH_INTERVAL_MS=15000
RPA_WORKER_PLATFORM_MIN_INTERVAL_MS=10000
RPA_WORKER_LEASE_WAIT_MS=120000
RPA_WORKER_LEASE_POLL_MS=2000
RPA_WORKER_TECHNICAL_COOLDOWN_MS=60000
RPA_WORKER_RATE_LIMIT_COOLDOWN_MS=900000
RPA_WORKER_DISK_WARNING_FREE_MB=5120
RPA_WORKER_DISK_STOP_FREE_MB=1024
RPA_WORKER_LOG_MAX_FILE_MB=100
RPA_WORKER_LOG_RETENTION_DAYS=14
RPA_WORKER_EVIDENCE_RETENTION_DAYS=7
# 平台明确不支持深度思考时：fail=任务技术失败；allow_degrade=允许实际状态为 null。
RPA_WORKER_DEEP_THINKING_UNSUPPORTED_POLICY=fail
